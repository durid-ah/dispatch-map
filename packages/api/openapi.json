{
  "openapi": "3.1.0",
  "info": {
    "title": "Dispatch Map API",
    "version": "0.1.0"
  },
  "paths": {
    "/events": {
      "get": {
        "tags": [
          "events"
        ],
        "summary": "Get Recent Events",
        "operationId": "get_recent_events_events_get",
        "parameters": [
          {
            "name": "hours",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 168,
              "minimum": 1,
              "default": 24,
              "title": "Hours"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EventWithCoords"
                  },
                  "title": "Response Get Recent Events Events Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/events/{external_id}/responders": {
      "get": {
        "tags": [
          "events"
        ],
        "summary": "Get Event Responders",
        "operationId": "get_event_responders_events__external_id__responders_get",
        "parameters": [
          {
            "name": "external_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "External Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventRespondersEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Event not found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/{full_path}": {
      "get": {
        "tags": [
          "spa"
        ],
        "summary": "Serve Spa",
        "description": "Serve the React production build, with SPA fallback for client routes.",
        "operationId": "serve_spa__full_path__get",
        "parameters": [
          {
            "name": "full_path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Full Path"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EventRespondersEnvelope": {
        "properties": {
          "external_id": {
            "type": "string",
            "title": "External Id"
          },
          "responders": {
            "items": {
              "$ref": "#/components/schemas/ResponderRead"
            },
            "type": "array",
            "title": "Responders",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "external_id"
        ],
        "title": "EventRespondersEnvelope"
      },
      "EventWithCoords": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "external_id": {
            "type": "string",
            "title": "External Id"
          },
          "time_received": {
            "type": "string",
            "format": "date-time",
            "title": "Time Received"
          },
          "call_type": {
            "type": "string",
            "title": "Call Type"
          },
          "location": {
            "type": "string",
            "title": "Location"
          },
          "location_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location Id"
          },
          "latitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latitude"
          },
          "longitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Longitude"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "external_id",
          "time_received",
          "call_type",
          "location",
          "location_id",
          "latitude",
          "longitude",
          "created_at",
          "updated_at"
        ],
        "title": "EventWithCoords"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ResponderRead": {
        "properties": {
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "dispatch_area": {
            "type": "string",
            "title": "Dispatch Area"
          },
          "agency": {
            "type": "string",
            "title": "Agency"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "statuses": {
            "items": {
              "$ref": "#/components/schemas/ResponderStatusRead"
            },
            "type": "array",
            "title": "Statuses",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "unit",
          "dispatch_area",
          "agency",
          "created_at"
        ],
        "title": "ResponderRead"
      },
      "ResponderStatusRead": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "status_order": {
            "type": "integer",
            "title": "Status Order"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "status",
          "status_order",
          "created_at"
        ],
        "title": "ResponderStatusRead"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
