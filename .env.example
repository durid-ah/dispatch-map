# ==============================================================================
# Database Configuration
# ==============================================================================
POSTGRES_USER=dispatch
POSTGRES_PASSWORD=dispatch
POSTGRES_DB=dispatch_map
POSTGRES_PORT=5430

# DB connection string for services running inside Docker Compose:
DB_URL=postgresql://dispatch:dispatch@db:5432/dispatch_map

# DB connection string for services running locally on host outside Docker:
# DB_URL=postgresql://dispatch:dispatch@localhost:5430/dispatch_map

# Environment (DEV or PROD)
ENV=DEV

# ==============================================================================
# Dispatch Consumer Service Configuration
# ==============================================================================
ACTIVE_CALLS_URL="https://apps.richmondgov.com/applications/activecalls/Home/ActiveCalls"
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:109.0) Gecko/20100101 Firefox/117.0"
GEOCODE_CITY="Richmond, VA"

# Nominatim Geocoding service URL
# Inside Docker (when Nominatim runs on host):
NOMINATIM_URL=http://host.docker.internal:8091/search
# On host directly:
# NOMINATIM_URL=http://localhost:8091/search

# ==============================================================================
# Frontend Web Configuration (Vite Dev Server)
# ==============================================================================
# API target for Vite dev proxy inside Docker:
VITE_API_URL=http://api:8000
# On host directly:
# VITE_API_URL=http://127.0.0.1:8000
